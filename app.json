{
  "expo": {
    "name": "EventEase",
    "slug": "EventEase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/eventease-icon.png",
    "scheme": "eventease",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0056B3",
        "foregroundImage": "./assets/images/eventease-android-foreground.png",
        "monochromeImage": "./assets/images/eventease-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0056B3",
          "image": "./assets/images/eventease-splash.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
